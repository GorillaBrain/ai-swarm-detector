# ============================================================================
# AI SWARM DETECTOR — Environment Configuration Template (.env.example)
# Copy to .env.local for local development. Never commit real keys to Git.
# ============================================================================

# 1. AI Classification Provider (Google Gemini via @google/genai SDK)
# Optional: When omitted, the platform automatically uses the deterministic
# evidence-based rule engine (rule-engine-v1) without failing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Persistent Database (Supabase PostgreSQL)
# Optional: When omitted, the platform uses the built-in persistent relational
# JSON file store (.data/ai_swarm_detector_db.json locally, /tmp on serverless)
# pre-hydrated from src/lib/db/initial-live-snapshot.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Scheduled Cron & Manual Ingestion Endpoint Security
# Optional bearer secret used by Vercel Cron to authenticate /api/cron/ingest
CRON_SECRET=
INGESTION_API_TOKEN=
